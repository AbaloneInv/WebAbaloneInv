form.addEventListener('submit', async (e) => {
  e.preventDefault();
  statusEl.className = ''; statusEl.textContent = '';
  if (!form.reportValidity()) return;
  if (form.company_site.value) return; // bot
  btn.disabled = true; btn.textContent = 'Enviando…';
  try {
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(Object.fromEntries([...new FormData(form)].filter(([k]) => k !== 'company_site')))
    });
    const data = await res.json();
    if (res.ok && data.success) {
      form.reset();
      statusEl.className = 'ok';
      statusEl.textContent = 'Mensaje enviado. Te responderemos lo antes posible.';
    } else { throw new Error(data.message || 'Error'); }
  } catch (err) {
    statusEl.className = 'err';
    statusEl.textContent = 'No se ha podido enviar el mensaje. Inténtalo de nuevo en unos minutos.';
  } finally {
    btn.disabled = false; btn.textContent = 'Enviar mensaje';
  }
});
</script>
</body>
</html>
